# 站点基础配置 (生产环境部署时自动由 astro.config.mjs 读取或在此覆盖)
PUBLIC_SITE_URL=https://username.github.io

# Giscus 评论系统配置 (选填，在 GitHub 仓库开启 Discussions 后从 giscus.app 获取)
PUBLIC_GISCUS_REPO=your-username/your-repo
PUBLIC_GISCUS_REPO_ID=R_kgDOXXXXXXXXXX
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOXXXXXXXXXX
