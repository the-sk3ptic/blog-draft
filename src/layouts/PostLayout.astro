---
import BaseLayout from '../layouts/BaseLayout.astro';

interface PostLink {
  title: string;
  slug: string;
}

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    tags: string[];
    category?: string;
    image?: string;
  };
  prevPost?: PostLink;
  nextPost?: PostLink;
}

const { frontmatter, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, updatedDate, tags, category, image } = frontmatter;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={title} description={description} image={image}>
  <article>
    <!-- Article Header -->
    <header class="mb-8 border-b border-[var(--color-border)] pb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-4 text-[var(--color-text)]">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-secondary)]">
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        {formattedUpdatedDate && (
          <span class="text-[var(--color-text-muted)]">
            （更新于 {formattedUpdatedDate}）
          </span>
        )}
        {category && (
          <a
            href={`/categories/${category}`}
            class="inline-block px-2 py-0.5 rounded bg-[var(--color-primary-100)] text-[var(--color-primary-700)] dark:bg-[var(--color-primary-900)] dark:text-[var(--color-primary-200)] text-xs font-medium"
          >
            {category}
          </a>
        )}
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="text-xs px-2 py-1 rounded-full bg-[var(--color-surface-alt)] text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)] transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Article Body -->
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <slot />
    </div>

    <!-- Post Navigation -->
    <nav class="mt-12 pt-8 border-t border-[var(--color-border)] grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a
          href={`/posts/${prevPost.slug}`}
          class="group flex flex-col p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary-400)] transition-colors"
        >
          <span class="text-sm text-[var(--color-text-muted)]">← 上一篇</span>
          <span class="text-[var(--color-text)] group-hover:text-[var(--color-primary-600)] transition-colors font-medium">
            {prevPost.title}
          </span>
        </a>
      ) : <div />}
      {nextPost && (
        <a
          href={`/posts/${nextPost.slug}`}
          class="group flex flex-col items-end p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary-400)] transition-colors sm:col-start-2"
        >
          <span class="text-sm text-[var(--color-text-muted)]">下一篇 →</span>
          <span class="text-[var(--color-text)] group-hover:text-[var(--color-primary-600)] transition-colors font-medium">
            {nextPost.title}
          </span>
        </a>
      )}
    </nav>

    <!-- Comments Section -->
    <div id="comments" class="mt-12 pt-8 border-t border-[var(--color-border)]">
      <!-- Giscus will be added in Phase 4 -->
    </div>
  </article>
</BaseLayout>
