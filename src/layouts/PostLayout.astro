---
import BaseLayout from '../layouts/BaseLayout.astro';
import TOC from '@/components/TOC.astro';
import CopyCode from '@/components/CopyCode.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import Giscus from '@/components/Giscus.astro';
import BackToTop from '@/components/BackToTop.astro';
import ArticleBanner, { type BannerData } from '@/components/ArticleBanner.astro';
import type { HeadingItem } from '@/components/TOC.astro';
import type { SeriesNav } from '@/utils/posts';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    lastModified?: Date;
    banner?: BannerData;
    tags: string[];
    category?: string;
    series?: {
      name: string;
      order?: number;
    };
    image?: string;
  };
  headings?: HeadingItem[];
  readingTime?: string;
  seriesNav?: SeriesNav | null;
}

const { frontmatter, headings = [], readingTime, seriesNav } = Astro.props;
const { title, description, pubDate, updatedDate, lastModified, banner, tags, category, image } = frontmatter;
const hasTOC = headings && headings.filter((h) => h.depth > 1 && h.depth < 4).length > 0;

const effectiveUpdatedDate = updatedDate ?? lastModified;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = effectiveUpdatedDate
  ? new Date(effectiveUpdatedDate).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  pubDate={pubDate}
  updatedDate={effectiveUpdatedDate}
  tags={tags}
  category={category}
  containerClass="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full"
>
  <div class="flex flex-col xl:flex-row justify-center items-start gap-10">
    <!-- Article Main Column -->
    <article class="w-full max-w-3xl min-w-0 mx-auto xl:mx-0">
      <!-- Article Header -->
      <header class="mb-8 border-b border-[var(--color-border)] pb-8">
        <h1 class="text-3xl md:text-4xl font-bold mb-4 text-[var(--color-text)] tracking-tight">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-secondary)]">
          <time datetime={pubDate.toISOString()} title={`发布于 ${formattedDate}`} class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>{formattedDate}</span>
          </time>
          {formattedUpdatedDate && (
            <span
              class="inline-flex items-center gap-1.5 text-[var(--color-text-muted)]"
              title={`最后编辑于 ${formattedUpdatedDate}`}
            >
              <svg class="w-3.5 h-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              <span>最后编辑于 {formattedUpdatedDate}</span>
            </span>
          )}
          {readingTime && (
            <>
              <span class="text-[var(--color-text-muted)]" aria-hidden="true">·</span>
              <span title={`预计阅读时间：${readingTime}`}>预计阅读 {readingTime}</span>
            </>
          )}
          {category && (
            <a
              href={`/categories/${category}`}
              class="inline-block px-2.5 py-0.5 rounded-full bg-[var(--color-primary-100)] text-[var(--color-primary-700)] dark:bg-[var(--color-primary-900)] dark:text-[var(--color-primary-200)] text-xs font-medium hover:opacity-80 transition-opacity"
              title={`浏览分类「${category}」下的所有文章`}
              aria-label={`文章分类：${category}`}
            >
              {category}
            </a>
          )}
        </div>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4" aria-label="文章标签列表">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="text-xs px-2.5 py-1 rounded-full bg-[var(--color-surface-alt)] text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)] hover:bg-[var(--color-surface-hover)] transition-colors"
                title={`查看标签为「${tag}」的文章`}
                aria-label={`标签：${tag}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        {/* Series Box (if post is part of a series) */}
        {seriesNav && (
          <div class="mt-6 p-4 rounded-xl border border-[var(--color-primary-300)] bg-[var(--color-primary-50)]/40 dark:border-[var(--color-primary-800)] dark:bg-[var(--color-primary-950)]/30 flex items-start gap-3">
            <span class="text-xl select-none" aria-hidden="true">📚</span>
            <div class="text-sm">
              <span class="font-semibold text-[var(--color-text)]">
                本文收录于合集：
              </span>
              <a
                href={`/series/${seriesNav.seriesName}`}
                class="font-medium text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] underline hover:opacity-80 transition-opacity ml-1"
                title={`前往查看合集《${seriesNav.seriesName}》完整文章目录`}
                aria-label={`查看合集：${seriesNav.seriesName}`}
              >
                《{seriesNav.seriesName}》
              </a>
              <span class="text-[var(--color-text-muted)] ml-2">
                （第 {seriesNav.currentIndex} / {seriesNav.total} 篇）
              </span>
            </div>
          </div>
        )}
      </header>

      <!-- Article Banner (时效性提示等横幅) -->
      {banner && (
        <ArticleBanner
          banner={banner}
          lastModified={effectiveUpdatedDate}
          pubDate={pubDate}
        />
      )}

      <!-- Article Body -->
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <slot />
      </div>

      <!-- Article Social Share Section -->
      <ShareButtons title={title} description={description} />

      <!-- Intra-Series Navigation (Only for series posts) -->
      {seriesNav && (seriesNav.prevPost || seriesNav.nextPost) && (
        <nav
          class="mt-10 pt-8 border-t border-[var(--color-border)]"
          aria-label="合集文章导航"
        >
          <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-4 flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            合集《{seriesNav.seriesName}》导航
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {seriesNav.prevPost ? (
              <a
                href={`/posts/${seriesNav.prevPost.slug}`}
                class="group flex flex-col p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary-400)] bg-[var(--color-surface)] transition-all shadow-xs"
                title={`合集上一篇：${seriesNav.prevPost.title}`}
                aria-label={`合集上一篇：${seriesNav.prevPost.title}`}
              >
                <span class="text-xs text-[var(--color-text-muted)] mb-1 flex items-center gap-1">
                  <span>←</span> 合集上一篇
                </span>
                <span class="text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-primary-600)] transition-colors line-clamp-2">
                  {seriesNav.prevPost.title}
                </span>
              </a>
            ) : <div />}

            {seriesNav.nextPost && (
              <a
                href={`/posts/${seriesNav.nextPost.slug}`}
                class="group flex flex-col items-end text-right p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary-400)] bg-[var(--color-surface)] transition-all shadow-xs sm:col-start-2"
                title={`合集下一篇：${seriesNav.nextPost.title}`}
                aria-label={`合集下一篇：${seriesNav.nextPost.title}`}
              >
                <span class="text-xs text-[var(--color-text-muted)] mb-1 flex items-center gap-1">
                  合集下一篇 <span>→</span>
                </span>
                <span class="text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-primary-600)] transition-colors line-clamp-2">
                  {seriesNav.nextPost.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )}

      <!-- Comments Section -->
      <Giscus />

      <!-- Code Block Copy Script -->
      <CopyCode />
    </article>

    <!-- Spacer to reserve horizontal room for the fixed right TOC on desktop -->
    {hasTOC && <div class="hidden xl:block w-60 shrink-0" aria-hidden="true" />}
  </div>

  <!-- Fixed Right TOC (Desktop fixed right sidebar + Mobile fixed floating drawer) -->
  {hasTOC && <TOC headings={headings} />}

  <!-- Back to top button -->
  <BackToTop />
</BaseLayout>
