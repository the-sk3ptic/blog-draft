---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  containerClass?: string;
}

const {
  title,
  description,
  image,
  containerClass = 'max-w-4xl mx-auto px-4 py-8 w-full',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-surface)] text-[var(--color-text)]">
    <Header />
    <main class:list={['flex-1', containerClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
