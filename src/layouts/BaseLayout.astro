---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '@/types';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  author?: string;
  containerClass?: string;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  pubDate,
  updatedDate,
  tags,
  category,
  author,
  containerClass = 'max-w-4xl mx-auto px-4 py-8 w-full',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      category={category}
      author={author}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-surface)] text-[var(--color-text)]">
    <Header />
    <main class:list={['flex-1', containerClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
