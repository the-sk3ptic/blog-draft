---
interface Props {
  tags: string[];
  size?: 'sm' | 'md';
}

const { tags, size = 'sm' } = Astro.props;
---

<div class:list={['tag-list', `tag-${size}`]} aria-label="标签列表">
  {tags.map((tag) => (
    <a
      href={`/tags/${tag}`}
      class="tag-pill"
      title={`查看所有包含「${tag}」标签的文章`}
      aria-label={`标签：${tag}`}
    >
      #{tag}
    </a>
  ))}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    font-weight: 500;
    text-decoration: none;
    background-color: var(--color-surface-alt);
    color: var(--color-text-secondary);
    transition: var(--transition-base);
  }

  .tag-pill:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-primary-500);
  }

  .tag-sm .tag-pill {
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
  }

  .tag-md .tag-pill {
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
  }
</style>
