---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Tags', href: '/tags' },
  { label: 'Categories', href: '/categories' },
  { label: 'Archive', href: '/archive' },
  { label: 'About', href: '/about' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="header">
  <nav class="nav-container">
    <a href="/" class="site-title">My Blog</a>

    <!-- Desktop nav -->
    <div class="nav-links">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </div>

    <!-- Mobile controls -->
    <div class="mobile-controls">
      <ThemeToggle />
      <button
        class="hamburger"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        id="menu-toggle"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line class="line-1" x1="3" y1="6" x2="21" y2="6" />
          <line class="line-2" x1="3" y1="12" x2="21" y2="12" />
          <line class="line-3" x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown -->
  <div class="mobile-menu" id="mobile-menu">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={['mobile-link', { active: isActive(item.href) }]}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('open');
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
    transition: var(--transition-base);
  }

  .nav-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    transition: var(--transition-base);
  }

  .site-title:hover {
    color: var(--color-primary-500);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: var(--transition-base);
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .nav-link.active {
    color: var(--color-primary-600);
    font-weight: 500;
  }

  .mobile-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    border-radius: 0.375rem;
    transition: var(--transition-base);
  }

  .hamburger:hover {
    background-color: var(--color-surface-hover);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: var(--transition-base);
  }

  .mobile-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .mobile-link.active {
    color: var(--color-primary-600);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }

    .mobile-controls {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }
</style>
