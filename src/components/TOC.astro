---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;

// Filter for h2 and h3
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{
  toc.length > 0 && (
    <>
      {/* 移动端/小屏幕：文章正文顶部的可折叠简易目录 */}
      <div class="xl:hidden not-prose mb-8">
        <details class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-3 text-sm">
          <summary
            class="flex items-center justify-between cursor-pointer font-medium text-[var(--color-text)] select-none list-none"
            aria-label="展开或收起文章目录"
            title="展开或收起文章目录"
          >
            <span class="flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              文章目录
            </span>
            <svg
              class="w-4 h-4 text-[var(--color-text-muted)] group-open:rotate-180 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <ul class="mt-3 space-y-1.5 border-t border-[var(--color-border)] pt-3">
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-4 text-xs' : 'font-medium'}>
                <a
                  href={`#${heading.slug}`}
                  class="block py-1 text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)] transition-colors"
                  title={`跳转到小节：${heading.text}`}
                  aria-label={`跳转到小节：${heading.text}`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>

      {/* 桌面端：Floating 悬浮在文档右侧的目录导航 */}
      <aside
        class="hidden xl:block w-64 shrink-0 not-prose"
        aria-label="页面目录导航"
      >
        <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-3 pb-2 border-b border-[var(--color-border)]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            目录导航
          </div>
          <nav>
            <ul class="space-y-1 text-sm border-l border-[var(--color-border)]">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class={`toc-desktop-link block py-1 border-l-2 -ml-[2px] border-transparent text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)] hover:border-[var(--color-primary-400)] transition-all ${
                      heading.depth === 3 ? 'pl-6 text-xs' : 'pl-3 font-normal'
                    }`}
                    data-slug={heading.slug}
                    title={`跳转到小节：${heading.text}`}
                    aria-label={`跳转到小节：${heading.text}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    </>
  )
}

<script>
  function setupDesktopTOCActiveState() {
    const links = document.querySelectorAll('.toc-desktop-link');
    if (!links.length) return;

    const headingElements: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (!headingElements.length) return;

    function onScroll() {
      const scrollPosition = window.scrollY + 120;
      let currentActiveSlug = '';

      for (let i = 0; i < headingElements.length; i++) {
        const heading = headingElements[i];
        if (heading.offsetTop <= scrollPosition) {
          currentActiveSlug = heading.id;
        } else {
          break;
        }
      }

      links.forEach((link) => {
        if (link.getAttribute('data-slug') === currentActiveSlug) {
          link.classList.add(
            'text-[var(--color-primary-600)]',
            'font-medium',
            'border-[var(--color-primary-600)]',
            'bg-[var(--color-primary-50)]/40',
            'dark:bg-[var(--color-primary-950)]/30'
          );
        } else {
          link.classList.remove(
            'text-[var(--color-primary-600)]',
            'font-medium',
            'border-[var(--color-primary-600)]',
            'bg-[var(--color-primary-50)]/40',
            'dark:bg-[var(--color-primary-950)]/30'
          );
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener('astro:page-load', setupDesktopTOCActiveState);
</script>
