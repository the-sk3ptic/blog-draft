---
export interface BannerData {
  type?: 'warning' | 'info' | 'tip' | 'caution' | 'danger';
  title?: string;
  content: string;
}

interface Props {
  banner?: BannerData | null;
  lastModified?: Date;
  pubDate?: Date;
}

const { banner, lastModified, pubDate } = Astro.props;

if (!banner) return null;

const type = banner.type || 'warning';
const title = banner.title || '时效性提示';
const content = banner.content;

const iconMap: Record<string, string> = {
  warning: '⚠️',
  info: 'ℹ️',
  tip: '💡',
  caution: '⚠️',
  danger: '🚨',
};
---

<aside
  class={`article-banner article-banner-${type}`}
  role="note"
  aria-label={title}
>
  <div class="banner-icon" aria-hidden="true">
    {iconMap[type] || '⚠️'}
  </div>
  <div class="banner-content-wrapper">
    <div class="banner-title">
      <span>{title}</span>
    </div>
    <div class="banner-text">
      {content}
    </div>
  </div>
</aside>

<style>
  .article-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    border-radius: 0.75rem;
    border-width: 1px;
    border-style: solid;
    transition: var(--transition-base);
  }

  .banner-icon {
    font-size: 1.25rem;
    line-height: 1.3;
    user-select: none;
    flex-shrink: 0;
  }

  .banner-content-wrapper {
    flex: 1;
    min-width: 0;
  }

  .banner-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .banner-text {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.92;
  }

  /* Warning / Caution */
  .article-banner-warning,
  .article-banner-caution {
    background-color: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
  }

  :global(.dark) .article-banner-warning,
  :global(.dark) .article-banner-caution {
    background-color: rgba(146, 64, 14, 0.15);
    border-color: rgba(217, 119, 6, 0.4);
    color: #fde68a;
  }

  /* Info */
  .article-banner-info {
    background-color: #eff6ff;
    border-color: #bfdbfe;
    color: #1e40af;
  }

  :global(.dark) .article-banner-info {
    background-color: rgba(30, 64, 175, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #bfdbfe;
  }

  /* Tip */
  .article-banner-tip {
    background-color: #ecfdf5;
    border-color: #a7f3d0;
    color: #065f46;
  }

  :global(.dark) .article-banner-tip {
    background-color: rgba(6, 95, 70, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #a7f3d0;
  }

  /* Danger */
  .article-banner-danger {
    background-color: #fff1f2;
    border-color: #fecdd3;
    color: #9f1239;
  }

  :global(.dark) .article-banner-danger {
    background-color: rgba(159, 18, 57, 0.15);
    border-color: rgba(244, 63, 94, 0.4);
    color: #fecdd3;
  }
</style>
