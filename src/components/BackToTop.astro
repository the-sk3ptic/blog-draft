---
---

<button
  type="button"
  id="back-to-top-btn"
  class="fixed bottom-20 right-6 xl:bottom-8 xl:right-8 z-40 w-10 h-10 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/90 backdrop-blur-md text-[var(--color-text-secondary)] shadow-md hover:text-[var(--color-primary-600)] hover:border-[var(--color-primary-400)] hover:shadow-lg transition-all duration-300 opacity-0 pointer-events-none translate-y-3 flex items-center justify-center cursor-pointer group"
  title="返回页面顶部"
  aria-label="返回页面顶部"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transition-transform duration-200 group-hover:-translate-y-0.5"
    aria-hidden="true"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script is:inline>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    if (!btn) return;

    const scrollContainer = document.getElementById('main-scroll-container');
    const scrollTarget = scrollContainer || window;

    function getScrollTop() {
      if (scrollContainer) {
        return scrollContainer.scrollTop;
      }
      return window.scrollY || document.documentElement.scrollTop;
    }

    function checkScroll() {
      const currentScroll = getScrollTop();
      if (currentScroll > 250) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
        btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    }

    btn.onclick = () => {
      if (scrollContainer) {
        scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };

    scrollTarget.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  }

  document.addEventListener('astro:page-load', setupBackToTop);
</script>
