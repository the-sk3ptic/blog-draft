---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, getAllCategories } from '@/utils/posts';

const posts = await getPublishedPosts();
const categories = getAllCategories(posts);
---

<BaseLayout title="分类">
  <section class="py-12">
    <h1 class="text-3xl font-bold mb-8">分类</h1>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[...categories.entries()].sort((a, b) => b[1] - a[1]).map(([category, count]) => (
        <a
          href={`/categories/${category}`}
          class="group block rounded-xl border border-zinc-200 dark:border-zinc-700 p-6 hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors"
        >
          <h2 class="text-lg font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-zinc-600 dark:group-hover:text-zinc-400 transition-colors">
            {category}
          </h2>
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            {count} 篇文章
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
