---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, getAllSeries } from '@/utils/posts';

const posts = await getPublishedPosts();
const seriesMap = getAllSeries(posts);
const seriesList = [...seriesMap.entries()];
---

<BaseLayout title="专栏合集" description="所有系列专栏与合集文章">
  <div class="max-w-4xl mx-auto py-8">
    <header class="text-center mb-12">
      <h1 class="text-3xl font-bold mb-3 tracking-tight">专栏合集</h1>
      <p class="text-sm text-[var(--color-text-secondary)]">
        系统化学习与连续性主题内容，按章节顺序精读
      </p>
    </header>

    {seriesList.length === 0 ? (
      <div class="text-center py-12 text-[var(--color-text-muted)]">
        <p>暂无合集文章</p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {seriesList.map(([seriesName, seriesPosts]) => (
          <a
            href={`/series/${seriesName}`}
            class="group p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-primary-400)] hover:shadow-md transition-all flex flex-col justify-between"
            title={`进入合集《${seriesName}》，共收录 ${seriesPosts.length} 篇文章`}
            aria-label={`合集：${seriesName}`}
          >
            <div>
              <div class="flex items-center gap-2 text-xs text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] font-semibold uppercase tracking-wider mb-2">
                <span class="text-base select-none">📚</span>
                <span>专栏系列</span>
              </div>
              <h2 class="text-xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-primary-600)] transition-colors mb-3">
                {seriesName}
              </h2>
              <p class="text-sm text-[var(--color-text-secondary)] line-clamp-2 mb-4">
                {seriesPosts[0]?.data.description || '精选系列文章集合'}
              </p>
            </div>

            <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-4 border-t border-[var(--color-border)]">
              <span>收录 {seriesPosts.length} 篇文章</span>
              <span class="group-hover:translate-x-1 transition-transform flex items-center gap-1 text-[var(--color-primary-600)] font-medium">
                开始阅读 →
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
