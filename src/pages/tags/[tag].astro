---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { getPublishedPosts, getAllTags, getPostsByTag } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return [...tags.keys()].map((tag) => ({
    params: { tag },
    props: { posts: getPostsByTag(posts, tag) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`标签: ${tag}`}>
  <section class="py-12">
    <div class="mb-8">
      <a
        href="/tags"
        class="text-sm text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
      >
        ← 所有标签
      </a>
    </div>
    <h1 class="text-3xl font-bold mb-2">
      {tag}
    </h1>
    <p class="text-zinc-500 dark:text-zinc-400 mb-8">
      共 {posts.length} 篇文章
    </p>
    <div class="grid gap-6">
      {posts.map((post) => (
        <Card post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
