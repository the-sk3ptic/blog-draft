---
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPublishedPosts, getSeriesNavigation } from '@/utils/posts';
import { getReadingTime } from '@/utils/reading-time';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const seriesNav = getSeriesNavigation(posts, post);
    return {
      params: { slug: post.id },
      props: {
        post,
        seriesNav,
      },
    };
  });
}

const { post, seriesNav } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = post.body ? getReadingTime(post.body) : '3 分钟';
---

<PostLayout
  frontmatter={post.data}
  headings={headings}
  readingTime={readingTime}
  seriesNav={seriesNav}
>
  <Content />
</PostLayout>
